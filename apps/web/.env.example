# Where the web server reaches the API from the inside (Kubernetes Service in production).
API_INTERNAL_URL=http://localhost:4000
# The canonical public origin, used for redirects, canonical URLs and the sitemap.
PUBLIC_ORIGIN=http://localhost:5173
# The apex domain. Requests to <slug>.<BASE_DOMAIN> redirect to the page for that slug.
# Use "localhost" in development and open http://water.localhost:5173 to try it.
BASE_DOMAIN=localhost
PORT=3000
