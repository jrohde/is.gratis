# PostgreSQL connection string. The only piece of infrastructure the API needs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/isgratis

# HTTP
PORT=4000
HOST=0.0.0.0
# Comma separated origins allowed to call the API from a browser. Leave empty to allow none.
CORS_ORIGINS=http://localhost:5173

# Sessions
# The cookie domain. Use ".is.gratis" in production so every subdomain shares the login.
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Run pending migrations on startup (handy in Kubernetes with a single replica or an init job).
MIGRATE_ON_START=true

# LLM for the first draft of a page. Any OpenAI-compatible chat completions endpoint works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# How many draft requests one IP may make per hour.
DRAFT_RATE_LIMIT_PER_HOUR=3
