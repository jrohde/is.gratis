# Public address of the site, for absolute links in MCP answers.
PUBLIC_ORIGIN=http://localhost:5173

# PostgreSQL, the only infrastructure the API needs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/isgratis
DATABASE_POOL_MAX=10

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
MIGRATE_ON_START=true

# Browser origins allowed to call the API cross-origin (normally none: the web app uses /api on the same host).
CORS_ORIGINS=
# Origins allowed to send POST/PUT requests. Supports one wildcard label. Empty disables the check.
TRUSTED_ORIGINS=http://localhost:5173
# Sessions. Use COOKIE_DOMAIN=.is.gratis and COOKIE_SECURE=true in production.
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Accounts with these emails become admin when they register.
ADMIN_EMAILS=you@example.com
# Salt for hashing IP addresses in the draft rate limit. Use a long random value.
IP_HASH_SALT=change-me

# LLM for first drafts: any OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=120000
DRAFT_RATE_LIMIT_PER_HOUR=3
DRAFT_GLOBAL_LIMIT_PER_HOUR=200
DRAFT_MAX_ATTEMPTS=3
DRAFT_POLL_INTERVAL_MS=2000

# Illustrations through an OpenAI-compatible images endpoint. Empty IMAGE_MODEL disables them.
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_SIZE=1536x1024
IMAGE_TIMEOUT_MS=180000
IMAGE_RATE_LIMIT_PER_HOUR=5
IMAGE_GLOBAL_LIMIT_PER_HOUR=50
DRAFT_WITH_IMAGE=false

# Sponsored spots: monthly base price plus a price per 1000 views in the last 30 days (cents).
SPONSOR_BASE_PRICE_CENTS=2500
SPONSOR_PRICE_PER_1000_VIEWS_CENTS=400

# Source link checks by the worker, between drafts.
SOURCE_CHECKS=true
SOURCE_CHECK_INTERVAL_DAYS=7
SOURCE_CHECK_BATCH=10
SOURCE_CHECK_TIMEOUT_MS=10000

# Related subjects on the search page, from the LLM: once per query, cached in Postgres.
SEARCH_RELATED=true
SEARCH_RELATED_PER_HOUR=120

# Varnish purge listener (host:port). Empty disables cache bans.
CACHE_BAN_TARGET=

# Number of proxies in front of the API whose X-Forwarded-For is trusted ("true" = all, for local use).
TRUST_PROXY=true
