# Used by docker compose. Copy to .env and adjust.

# Accounts with these emails become admin when they register (comma separated).
ADMIN_EMAILS=you@example.com

# Any OpenAI-compatible endpoint. For a model in your own cluster or on this machine:
#   LLM_BASE_URL=http://ollama:11434/v1   (docker compose --profile llm)
#   LLM_BASE_URL=http://vllm.llm.svc:8000/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Illustrations (optional). Any OpenAI-compatible images endpoint; leave IMAGE_MODEL empty to disable.
# IMAGE_BASE_URL and IMAGE_API_KEY fall back to the LLM settings.
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_API_KEY=
# Also illustrate every new LLM draft.
DRAFT_WITH_IMAGE=false

IP_HASH_SALT=change-me
